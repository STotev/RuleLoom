### Requests for the ASP.NET Core sample. Start it with:
###   dotnet run --project samples/RuleLoom.Samples.AspNetCore
### Written for the JetBrains (Rider) HTTP client: the pre-request scripts set due times relative to now.

@baseUrl = http://localhost:5080

### The catalog document: events and their contexts, context schemas, operators and actions, as a rule-authoring UI reads them.
GET {{baseUrl}}/catalog

### acme-shop: VIP order awaiting payment from a gold customer.
### Matches "VIP order" (email now; @customer.Tier is gold), "Big basket" (log), "Loyalty check" (3 earlier orders,
### from the orderHistory context) and "Payment reminder" (scheduled 1 minute before PaymentDueAt, so about a minute
### from now). Every acme-shop response lists "Silver upgrade" and "Shipped SMS" as invalid.
< {%
    request.variables.set("paymentDueAt", new Date(Date.now() + 2 * 60 * 1000).toISOString());
%}
POST {{baseUrl}}/events
Content-Type: application/json

{
  "eventType": "OrderPlaced",
  "tenantId": "acme-shop",
  "entityId": "order-1001",
  "current": {
    "Number": "SO-1001",
    "Status": "AwaitingPayment",
    "Total": 640.50,
    "ItemCount": 6,
    "PaymentDueAt": "{{paymentDueAt}}",
    "Customer": { "Name": "Ada", "Email": "ada@example.com" }
  }
}

### acme-shop: the same order from a bronze customer. "VIP order" doesn't match; "Loyalty check" finds no earlier orders.
POST {{baseUrl}}/events
Content-Type: application/json

{
  "eventType": "OrderPlaced",
  "tenantId": "acme-shop",
  "entityId": "order-1002",
  "current": {
    "Number": "SO-1002",
    "Status": "Paid",
    "Total": 640.50,
    "ItemCount": 2,
    "Customer": { "Name": "Bob", "Email": "bob@example.com" }
  }
}

### acme-shop: status changes from AwaitingPayment to Paid. Matches "Order status changed" (changed + previous).
POST {{baseUrl}}/events
Content-Type: application/json

{
  "eventType": "OrderUpdated",
  "tenantId": "acme-shop",
  "entityId": "order-1001",
  "current": { "Number": "SO-1001", "Status": "Paid", "Total": 640.50, "Customer": { "Email": "ada@example.com" } },
  "previous": { "Number": "SO-1001", "Status": "AwaitingPayment", "Total": 640.50, "Customer": { "Email": "ada@example.com" } }
}

### acme-shop: an update without a status change (the total is written differently). Nothing matches.
POST {{baseUrl}}/events
Content-Type: application/json

{
  "eventType": "OrderUpdated",
  "tenantId": "acme-shop",
  "entityId": "order-1001",
  "current": { "Number": "SO-1001", "Status": "Paid", "Total": 640.5, "Customer": { "Email": "ada@example.com" } },
  "previous": { "Number": "SO-1001", "Status": "Paid", "Total": 640.50, "Customer": { "Email": "ada@example.com" } }
}

### wheels-market: a new ad. Matches "Ad published": logs now, emails the seller in 30 seconds.
POST {{baseUrl}}/events
Content-Type: application/json

{
  "eventType": "AdPublished",
  "tenantId": "wheels-market",
  "entityId": "ad-77",
  "current": {
    "Title": "2019 hatchback, one owner",
    "Status": "Published",
    "Price": 10500,
    "Seller": { "Name": "Grace", "Email": "grace@example.com" }
  }
}

### wheels-market: the price drops below 10k. Matches "Price drop" ($previous.Price); the action condition adds the bargain log.
POST {{baseUrl}}/events
Content-Type: application/json

{
  "eventType": "AdUpdated",
  "tenantId": "wheels-market",
  "entityId": "ad-77",
  "current": { "Title": "2019 hatchback, one owner", "Status": "Published", "Price": 9800, "Seller": { "Email": "grace@example.com" } },
  "previous": { "Title": "2019 hatchback, one owner", "Status": "Published", "Price": 10500, "Seller": { "Email": "grace@example.com" } }
}

### Unknown tenant: 404.
POST {{baseUrl}}/events
Content-Type: application/json

{
  "eventType": "OrderPlaced",
  "tenantId": "globex",
  "entityId": "order-1",
  "current": { "Total": 10 }
}
