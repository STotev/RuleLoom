[
  {
    "id": "big-basket",
    "name": "Big basket",
    "eventType": "OrderPlaced",
    "condition": { "operator": "gte", "operands": [{ "path": "ItemCount" }, { "value": 5 }] },
    "actions": [
      { "action": "console-log", "parameters": { "message": "Big basket: offer free shipping on the next order" } }
    ]
  },
  {
    "id": "loyalty-check",
    "name": "Loyalty check",
    "eventType": "OrderPlaced",
    "condition": { "operator": "gte", "operands": [{ "path": "Total" }, { "value": 100 }] },
    "actions": [
      { "action": "loyalty-check" }
    ]
  },
  {
    "id": "silver-upgrade",
    "name": "Silver upgrade (invalid: Teir is a typo)",
    "eventType": "OrderPlaced",
    "condition": { "operator": "eq", "operands": [{ "path": "@customer.Teir" }, { "value": "bronze" }] },
    "actions": [
      { "action": "console-log", "parameters": { "message": "Offer a silver upgrade" } }
    ]
  },
  {
    "id": "shipped-sms",
    "name": "Shipped SMS (invalid: no send-sms action is registered)",
    "eventType": "OrderUpdated",
    "condition": { "operator": "eq", "operands": [{ "path": "Status" }, { "value": "Shipped" }] },
    "actions": [
      { "action": "send-sms", "parameters": { "to": "Customer.Phone" } }
    ]
  },
  {
    "id": "gift-wrap",
    "name": "Gift wrap (malformed: no condition)",
    "eventType": "OrderPlaced",
    "actions": [
      { "action": "console-log", "parameters": { "message": "Offer gift wrapping" } }
    ]
  }
]
