[
  {
    "id": "vip-order",
    "name": "VIP order",
    "eventType": "OrderPlaced",
    "condition": {
      "operator": "and",
      "operands": [
        { "operator": "gte", "operands": [{ "path": "Total" }, { "value": 500 }] },
        { "operator": "eq", "operands": [{ "path": "@customer.Tier" }, { "value": "gold" }] }
      ]
    },
    "actions": [
      { "action": "send-email", "parameters": { "to": { "$path": "@customer.Email" }, "subject": "Thank you for your order: a gift is on its way" } }
    ]
  },
  {
    "id": "payment-reminder",
    "name": "Payment reminder",
    "eventType": "OrderPlaced",
    "condition": { "operator": "eq", "operands": [{ "path": "Status" }, { "value": "AwaitingPayment" }] },
    "actions": [
      {
        "action": "send-email",
        "parameters": { "to": { "$path": "Customer.Email" }, "subject": "Reminder: your payment is due in 30 seconds" },
        "schedule": { "mode": "Advance", "amount": 30, "unit": "Seconds", "referencePath": "PaymentDueAt" }
      }
    ]
  },
  {
    "id": "order-paid",
    "name": "Order paid",
    "eventType": "OrderUpdated",
    "condition": {
      "operator": "and",
      "operands": [
        { "operator": "changed", "operands": [{ "path": "Status" }] },
        { "operator": "eq", "operands": [{ "path": "Status" }, { "value": "Paid" }] }
      ]
    },
    "actions": [
      { "action": "send-email", "parameters": { "to": { "$path": "Customer.Email" }, "subject": "Payment received, thank you" } }
    ]
  },
  {
    "id": "order-shipped",
    "name": "Order shipped",
    "eventType": "OrderUpdated",
    "condition": {
      "operator": "and",
      "operands": [
        { "operator": "changed", "operands": [{ "path": "Status" }] },
        { "operator": "eq", "operands": [{ "path": "Status" }, { "value": "Shipped" }] }
      ]
    },
    "actions": [
      { "action": "send-email", "parameters": { "to": { "$path": "Customer.Email" }, "subject": "Your order is on its way" } },
      {
        "action": "send-email",
        "parameters": { "to": { "$path": "Customer.Email" }, "subject": "How was your order? Leave a review" },
        "schedule": { "mode": "Delay", "amount": 20, "unit": "Seconds" }
      }
    ]
  }
]
